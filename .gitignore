# R build artefacts
*.Rproj.user
*.Rhistory
*.RData
*.Ruserdata
.Rproj.user/

# R CMD check / build output
*.tar.gz
*.zip
biomAid.Rcheck/

# Generated documentation (re-built by devtools::document())
# man/ is kept in source control so the package is usable without devtools
# but the check log is not
00check.log
00install.out

# OS
.DS_Store
Thumbs.db

# Editor temp files (Emacs, vim)
\#*\#
.\#*
*~
*.swp
*.swo

# Scratch folder — exploratory scripts, never bundled into the package
scratch/

# Internal developer notes for the coding assistant, not user documentation.
# Note: pkgdown still renders any top-level .md it finds on disk, so
# scratch/build_pkgdown.R also deletes docs/CLAUDE.html after building.
CLAUDE.md

# Quarto intermediate build artefacts (rendered HTML in docs/ IS committed)
vignettes/.quarto/
vignettes/*_files/

# knitr chunk caches (re-generated on render; not needed in source control)
vignettes/*_cache/

# Stray R graphics output
Rplots.pdf
